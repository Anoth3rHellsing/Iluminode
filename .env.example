# Encryption key for AES-256-GCM (32 bytes, hex-encoded)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Session cookie secret (any random string)
SESSION_SECRET=change-me-to-a-random-string

# Port (Replit uses PORT env var automatically)
PORT=3000